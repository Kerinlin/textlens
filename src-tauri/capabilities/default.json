{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal permissions shared by Flick local renderer windows",
  "windows": ["settings", "selection-toolbar", "selection-result-*", "screenshot-overlay", "shot-pin-*"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging"
  ]
}
